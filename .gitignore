node_modules
dist
.env
.DS_Store
logging/*.log
!logging/.gitkeep
mysql_dumps/*.sql
!mysql_dumps/.gitkeep

.env*

# Persisted user-uploaded pictures are runtime data and must never be committed.
userimages/

# Runtime-generated scheduled-job artifacts are not source-controlled.
jobs/*
!jobs/.gitkeep
!jobs/commercials/
jobs/commercials/*
!jobs/commercials/.gitkeep

# Downloaded/managed runtime tools are environment-specific and not source-controlled.
.runtime/

# Runtime checkpoint/temp files for Build Golf Course Emails are not source-controlled.
docs/golfCourseEmails.csv.checkpoint.json
docs/golfCourseEmails.csv.checkpoint.json.*.tmp
docs/golfCourseEmails.csv.*.tmp
