{
  "name": "golf-scramble-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/scripts/local-dev.js",
    "dev:client": "vite",
    "dev:server": "node server/scripts/reset-session-logs.js && nodemon server/index.js",
    "start": "node server/scripts/reset-session-logs.js && node server/index.js",
    "prebuild": "node server/scripts/cleanup-logs.js",
    "build": "vite build",
    "postinstall": "npm run cleanup:project-files && npm run db:migrate && npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test test/app.test.js test/migration-compatibility.test.js test/schema-backup.test.js test/schema-rollback.test.js test/dependency-security.test.js test/tournament-discovery.test.js test/golf-course-public-pages.test.js test/tournament-start-schedule.test.js test/tournament-final-leaderboard.test.js test/tournament-archive.test.js test/account-data-reset.test.js test/demo-data-scripts.test.js test/host-portal-account-management.test.js test/find-course.test.js test/team-challenge-scoring.test.js test/tournament-time-zone.test.js test/notifications.test.js test/challenge-enhancements.test.js test/golfhomiez-tournament-scrub.test.js",
    "seed:homepage-demo": "node server/scripts/seed-homepage-demo.js",
    "db:rollback:chat": "node server/scripts/run-one-time-chat-schema-rollback.js",
    "db:migrate": "node server/run-migrations.js",
    "golf-courses:import-opengolfapi": "node server/scripts/import-opengolfapi-courses.js",
    "golf-courses:import": "node server/scripts/import-opengolfapi-courses.js",
    "golf-courses:backfill-opengolfapi-details": "node server/scripts/backfill-opengolfapi-course-details.js",
    "golf-courses:import-opengolfapi-details": "node server/scripts/backfill-opengolfapi-course-details.js",
    "cleanup:project-files": "node server/scripts/cleanup-project-files.js",
    "test:security": "node --test test/dependency-security.test.js",
    "security:audit": "npm audit --audit-level=low",
    "data:reset:user": "node server/scripts/reset-account-data.js user --all",
    "data:reset:host": "node server/scripts/reset-account-data.js host --all",
    "data:reset:organizer": "node server/scripts/reset-account-data.js organizer --all",
    "data:populate:user": "node server/scripts/populate-demo-data.js user",
    "data:populate:host": "node server/scripts/populate-demo-data.js host",
    "data:populate:organizer": "node server/scripts/populate-demo-data.js organizer",
    "data:populate:all": "node server/scripts/populate-demo-data.js all",
    "data:delete-user": "node server/scripts/delete-user-data.js"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "better-auth": "^1.6.25",
    "cors": "^2.8.5",
    "country-state-city": "^3.2.1",
    "dotenv": "^17.3.1",
    "express": "^4.22.2",
    "mysql2": "^3.11.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^11.1.1",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.9.0",
    "nodemon": "^3.1.4",
    "typescript": "^5.5.4",
    "vite": "^6.4.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "body-parser": "1.20.6",
    "js-yaml": "4.3.0",
    "kysely": "0.28.17",
    "postcss": "8.5.23",
    "qs": "6.15.3"
  }
}
