PORT=5001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=golf_homiez
DB_USER=golf_homiez_user
DB_PASSWORD=change_me
CLIENT_ORIGIN=http://127.0.0.1:5174
BETTER_AUTH_URL=http://127.0.0.1:5001
DEV_CLIENT_ORIGIN=http://127.0.0.1:5174

# Stripe subscriptions (use test-mode values for local development)
BILLING_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_1UAxmABU51fzGs8P1QXs110B
# Stripe-hosted Checkout branding. Logo/icon URLs must be public HTTPS images.
STRIPE_CHECKOUT_BRAND_NAME=Golf Homiez
STRIPE_CHECKOUT_BACKGROUND_COLOR=#F6FBF7
STRIPE_CHECKOUT_BUTTON_COLOR=#15803D
STRIPE_CHECKOUT_FONT_FAMILY=inter
STRIPE_CHECKOUT_BORDER_STYLE=rounded
STRIPE_CHECKOUT_LOGO_URL=
STRIPE_CHECKOUT_ICON_URL=
STRIPE_CHECKOUT_SUBMIT_MESSAGE=Your Golf Homiez membership helps us keep building a better golf community.
STRIPE_CHECKOUT_AFTER_SUBMIT_MESSAGE=Welcome to the Golf Homiez Community!
STRIPE_REQUIRE_TERMS_ACCEPTANCE=false
# Create/update this configuration with: npm run stripe:configure-portal
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PORTAL_DIRECT_PAYMENT_UPDATE=true
STRIPE_PORTAL_HEADLINE=Manage your Golf Homiez membership and payment details.
STRIPE_PRIVACY_POLICY_URL=
STRIPE_TERMS_OF_SERVICE_URL=
# Generate with: openssl rand -hex 32
ACCESS_CODE_HASH_SECRET=replace_with_a_random_64_character_secret
DEV_API_ORIGIN=http://127.0.0.1:5001
BETTER_AUTH_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
VITE_AUTH_BASE_URL=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_login
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM=Golf Homiez <your-verified-sender@yourdomain.com>
SMTP_CLIENT_NAME=localhost

BREVO_API_KEY=
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Golf Homiez
# Golfbert API course datasource
GOLFBERT_API_KEY=
GOLFBERT_API_BASE_URL=https://api.golfbert.com
GOLFBERT_API_KEY_HEADER=x-api-key
GOLFBERT_API_AUTH_SCHEME=aws4
GOLFBERT_API_ACCESS_KEY=
GOLFBERT_API_SECRET_KEY=
GOLFBERT_API_REGION=us-east-1
GOLFBERT_API_SERVICE=execute-api
GOLFBERT_CACHE_TTL_MS=900000
GOLFBERT_COURSE_PAGE_SIZE=100

# Feature flags
FEATURE_PROFILE_SOCIAL_PREFERENCES=false

# Tournament discovery crawler (getTournaments scheduled job)
TOURNAMENT_CRAWL_MAX_PAGES_PER_COURSE=4
TOURNAMENT_CRAWL_TIMEOUT_MS=10000

# OpenGolfAPI golf-course catalog refresh (getGolfCourseData scheduled job)
OPEN_GOLF_API_BASE_URL=https://api.opengolfapi.org
# Optional Bearer token. Strongly recommended for a full US refresh because anonymous reads are rate limited.
OPEN_GOLF_API_KEY=
# Official OpenGolfAPI bulk catalog used to supplement the capped state endpoint.
OPEN_GOLF_API_BULK_DATASET_URL=https://github.com/opengolfapi/data/releases/latest/download/opengolfapi-us.geojson.gz
# OpenGolfAPI currently allows up to 500 records on /v1/courses/state/{STATE}.
OPEN_GOLF_API_STATE_PAGE_LIMIT=500
# Fast import mode is designed for a full-US refresh in approximately 12 hours when
# the API key has enough daily quota. It uses the official bulk file for course metadata,
# avoids the redundant /courses/{id} request, enriches holes + tees concurrently, and
# writes hole rows to MySQL in batches. Set false only for legacy/debug behavior.
OPEN_GOLF_API_FAST_MODE=true
OPEN_GOLF_API_USE_COURSE_DETAIL_ENDPOINT=false
OPEN_GOLF_API_IMPORT_CONCURRENCY=8
OPEN_GOLF_API_TARGET_RUN_HOURS=12
# Minimum spacing between REST request starts. 750ms is ~1.33 requests/second and
# gives the 2-request/course fast path enough headroom for a ~12-hour end-to-end run.
OPEN_GOLF_API_REQUEST_INTERVAL_MS=750
OPEN_GOLF_API_MAX_RETRIES=6
OPEN_GOLF_API_RETRY_BASE_MS=2000
OPEN_GOLF_API_RETRY_MAX_MS=120000
# Keep a small daily request reserve and pause until X-RateLimit-Reset when the
# remaining budget reaches the reserve. The wait is cancellation-aware.
OPEN_GOLF_API_RATE_LIMIT_RESERVE=5
OPEN_GOLF_API_RATE_LIMIT_RESET_GRACE_MS=5000
OPEN_GOLF_API_WAIT_FOR_DAILY_RESET=true
# Leave disabled for fast mode. Enabling it spreads the remaining quota across the
# entire UTC day and can make a full import exceed the 12-hour target.
OPEN_GOLF_API_ADAPTIVE_DAILY_PACING=false
# Optional extra delays used only by the scheduled import orchestration.
OPEN_GOLF_API_IMPORT_DELAY_MS=0
OPEN_GOLF_API_IMPORT_STATE_DELAY_MS=0

# Persistent directory for compressed round/tournament pictures
USER_IMAGES_DIR=./userimages


# Create Short-form Current Events - Small scheduled job
# Use an installed ffmpeg executable when available. If this resolves to a missing
# command, GolfHomiez downloads a pinned/checksummed ffmpeg 6.1.1 runtime copy.
FFMPEG_PATH=ffmpeg
FFMPEG_AUTO_DOWNLOAD=true
# Managed ffmpeg download timeout in milliseconds (10,000-600,000).
FFMPEG_DOWNLOAD_TIMEOUT_MS=120000
# Per-source website timeout in milliseconds (1,000-60,000).
CURRENT_EVENTS_FETCH_TIMEOUT_MS=10000
# Optional explicit font for current-events drawtext; blank uses platform font discovery.
CURRENT_EVENTS_FONT_FILE=

# Shared Pexels API key for Create Short-form Great Shots - Small, Create Short-form Funny Shots - Small, and Create Short-form Current Events - Small.
# Great Shots uses Pexels Videos for great golf shots. Funny Shots uses Pexels Videos for funny golf shots/fails/reactions. Current Events uses Pexels Photos/Videos as its primary visual source.
# Obtain the account API key at:
# https://www.pexels.com/api/key/
# Keep the real key server-side in .env; never expose it through VITE_* variables or commit it.
PEXELS_API_KEY=
# When PEXELS_API_KEY is blank/unavailable, Great Shots falls back to Wikimedia Commons,
# Mixkit Free License, Internet Archive, and the GolfHomiez-generated fallback clip. Funny Shots
# requires Pexels because its selector intentionally targets funny Pexels golf footage. Current Events
# falls back to current golf-news website images and generated GolfHomiez visuals.
# Internet metadata/API-search timeout in milliseconds (1,000-60,000).
GREAT_SHOTS_FETCH_TIMEOUT_MS=15000
# Selected video-download timeout in milliseconds (1,000-120,000).
GREAT_SHOTS_VIDEO_TIMEOUT_MS=30000
# Maximum source-video download size in bytes (1 MB-150 MB).
GREAT_SHOTS_MAX_VIDEO_BYTES=62914560
# Optional explicit font file used by ffmpeg drawtext. Leave blank to auto-detect a local system font.
GREAT_SHOTS_FONT_FILE=

# Create Short-form Funny Shots - Small uses the same Pexels key and ffmpeg/font setup as Great Shots.
FUNNY_SHOTS_FETCH_TIMEOUT_MS=15000
FUNNY_SHOTS_VIDEO_TIMEOUT_MS=30000
FUNNY_SHOTS_MAX_VIDEO_BYTES=62914560

# Great Shots and Funny Shots include subtle background audio derived from the Golf Homiez for Golf Courses commercial.
# Leave the path blank to use the bundled server/assets/golf-homiez-for-golf-courses-background.m4a file.
COMMERCIAL_BACKGROUND_MUSIC_FILE=
# Mix level applied by ffmpeg. Accepted range is 0.02-0.35; 0.12 is intentionally subtle.
COMMERCIAL_BACKGROUND_MUSIC_VOLUME=0.12
